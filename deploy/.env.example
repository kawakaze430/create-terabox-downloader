# Optional local values for compose.yaml. API and web have no published ports.
SITE_ADDRESS=http://:80
INGRESS_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# Managed HTTPS deployment (compose.managed.yaml). Replace the domain and ensure DNS
# points to the host. Store the runtime key in a separate owner-only file.
# SITE_ADDRESS=files.example.net
# INGRESS_BIND=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443
# PUBLIC_ORIGIN=https://files.example.net
# TRANSFER_ENV_FILE=/absolute/private/transfer.env

# Override these together if the private network overlaps existing routes.
# Keep the fixed proxy address outside the range of dynamically assigned addresses.
# PROXY_SUBNET=172.31.240.0/28
# PROXY_DYNAMIC_RANGE=172.31.240.8/29
# PROXY_IP=172.31.240.2
