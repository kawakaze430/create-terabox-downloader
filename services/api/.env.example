ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Request official partner access before filling these. NEVER commit real credentials.
TERABOX_CLIENT_ID=
TERABOX_CLIENT_SECRET=
TERABOX_PRIVATE_SECRET=

# Per-process guard. Enforce aggregate limits at the reverse proxy for replicas.
API_MAX_BODY_BYTES=4096
API_REQUESTS_PER_MINUTE=60
API_MAX_RATE_CLIENTS=10000
API_MAX_INFLIGHT=16
API_BODY_TIMEOUT_SECONDS=5
API_PROVIDER_TIMEOUT_SECONDS=10

# Operator-only probe configuration. Does NOT enable the public API provider.
# Only mark true after partner approval for the intended scope is confirmed.
TERABOX_PARTNER_APPROVED=false
TERABOX_ACCESS_TOKEN=
# Comma-separated exact hostnames, no URLs/wildcards/spaces. Confirm with partner.
TERABOX_APPROVED_API_HOSTS=
TERABOX_APPROVED_DOWNLOAD_HOSTS=
# A small, non-sensitive, operator-owned public /s/1... share and file ID.
TERABOX_TEST_SHARE_URL=
TERABOX_TEST_FILE_ID=
TERABOX_TEST_SHA256=
TERABOX_TEST_MAX_BYTES=1048576
