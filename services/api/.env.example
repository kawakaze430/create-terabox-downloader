API_REQUESTS_PER_MINUTE=60
API_MAX_RATE_CLIENTS=10000
API_MAX_INFLIGHT=16
API_BODY_TIMEOUT_SECONDS=5
API_PROVIDER_TIMEOUT_SECONDS=10
